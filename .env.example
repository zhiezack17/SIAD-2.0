# ==============================================================
# SIAD 2.0 - Konfigurasi Lingkungan (Environment Variables)
# Salin file ini menjadi .env dan sesuaikan nilainya.
# JANGAN PERNAH MENYIMPAN ATAU MENG-COMMIT KREDENSIAL ASLI KE GIT!
# ==============================================================

# Node Environment ('production' atau 'development')
NODE_ENV=production
PORT=3000

# PostgreSQL Database Connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=siad_user
DB_PASSWORD=your_secure_db_password_here
DB_NAME=siad

# Keamanan Sesi (Wajib diisi string acak minimal 32 karakter di production)
SESSION_SECRET=ganti_dengan_random_string_minimal_32_karakter_acak
SESSION_MAX_AGE_DAYS=1
COOKIE_SECURE=true

# Google Drive Service Account (Opsional: simpan JSON string kredensial langsung di env)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
