// PATCH 12 MENU (PINDAH ATAS): Aset & BUMDes routes (URUTAN PALING ATAS AGAR TIDAK TER-INTERCEPT ROUTE PATTERN LAIN)
router.get('/aset', async (req, res) => {
    if (!req.session || !req.session.user) { return res.redirect('/login'); }
    try {
        const db = require('../config/db');
        const admin = !req.session.user.kepenghuluan_id; const did = req.session.user.kepenghuluan_id || null;
        let sql = 'SELECT * FROM aset WHERE 1=1'; let p = [];
        if (!admin && did) {
            try {
                const col = await db.query("SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='aset' AND column_name='kepenghuluan_id' LIMIT 1");
                if (col.rows.length > 0) { sql += ' AND (kepenghuluan_id = $1 OR kepenghuluan_id IS NULL)'; p.push(did); }
            } catch(e) {}
        }
        sql += ' ORDER BY id DESC LIMIT 100';
        let rows = []; try { rows = (await db.query(sql, p)).rows; } catch(e) { rows = []; }
        return res.render('aset', { title: 'Inventaris Aset Desa - SIAD 2.0', data: rows });
    } catch (e) { console.error('aset-error:', e.message); return res.render('aset', { title: 'Inventaris Aset Desa - SIAD 2.0', data: [] }); }
});
