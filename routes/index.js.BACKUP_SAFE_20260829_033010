// Helper count filter per table + desa
const countFiltered = async (tbl, req) => {
    const admin = ac.isAdmin(req); const did = ac.getDesaId(req);
    let sql = `SELECT COUNT(*) FROM ${tbl} WHERE 1=1`; let p = [];
    if (!admin && did) {
        try {
            const testCol = await db.query(
                `SELECT column_name FROM information_schema.columns WHERE table_schema='public' AND table_name=$1 AND column_name='kepenghuluan_id' LIMIT 1`,
                [tbl]
            );
            if (testCol.rows.length > 0) { sql += ` AND (kepenghuluan_id = $1 OR kepenghuluan_id IS NULL)`; p.push(did); }
        } catch (e) { /* noop */ }
    }
    try { return (await db.query(sql, p)).rows[0].count; } catch (e) { return 0; }
};

