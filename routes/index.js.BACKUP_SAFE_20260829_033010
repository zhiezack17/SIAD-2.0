// --- Rute Dashboard ---
router.get('/dashboard', requireAuth, async (req, res) => {
    try {
        const admin = ac.isAdmin(req); const did = ac.getDesaId(req);
        let stats = { total_workspace: 0, dokumen_terarsip: 0, total_surat_masuk: 0, total_surat_keluar: 0 };
        try { stats.total_surat_masuk = await countFiltered('surat_masuk', req); } catch(e){}
        try { stats.total_surat_keluar = await countFiltered('surat_keluar', req); } catch(e){}
        try {
            // workspace dokumen count
            const docCount = await countFiltered('workspace_document', req);
            const arsipCount = await countFiltered('arsip_desa', req);
            const spjDocCount = await countFiltered('spj_dokumen', req);
            const produkCount = await countFiltered('produk_hukum', req);
            stats.dokumen_terarsip = (Number(docCount)||0) + (Number(arsipCount)||0) + (Number(spjDocCount)||0) + (Number(produkCount)||0);
        } catch(e){}
        let workspaces = [];
        try {
            let baseWs = `
                SELECT w.*, wt.nama as type_nama, wt.warna as type_warna, wt.icon as type_icon, mk.nama as kepenghuluan_nama
                FROM workspace w
                LEFT JOIN workspace_type wt ON w.workspace_type_id = wt.id
                LEFT JOIN kepenghuluan mk ON w.kepenghuluan_id = mk.id
                WHERE 1=1`;
            let p = []; let i = 1;
            if (!admin && did) {
                // Check if workspace table has column first
                try {
                    const colCheck = await db.query(
                        `SELECT column_name FROM information_schema.columns WHERE table_schema='public' AND table_name='workspace' AND column_name='kepenghuluan_id' LIMIT 1`
                    );
                    if (colCheck.rows.length > 0) {
                        baseWs += ` AND (w.kepenghuluan_id = $${i} OR w.kepenghuluan_id IS NULL)`;
                        p.push(did);
                        i++;
                    }
                } catch (e) { /* noop */ }
            }
            baseWs += ` ORDER BY w.created_at DESC LIMIT 5`;
            const ws = await db.query(baseWs, p);
            workspaces = ws.rows;
            // total workspace count (separate)
            stats.total_workspace = await countFiltered('workspace', req);
        } catch(e){
            try { const wsFallback = await db.query(`SELECT * FROM workspace ORDER BY created_at DESC LIMIT 5`); workspaces = wsFallback.rows; stats.total_workspace = workspaces.length; } catch(err){}
        }
        res.render('dashboard', { title: 'Dashboard - SIAD 2.0', stats: stats, workspaces: workspaces, recentActivities: [], kegiatan: [], dokumen: [], arsip: [] });
    } catch(e) {
        console.error('Dashboard error:', e);
        res.render('dashboard', { title: 'Dashboard - SIAD 2.0', stats: null, workspaces: [], recentActivities: [], kegiatan: [], dokumen: [], arsip: [] });
    }
});

