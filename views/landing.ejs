<!DOCTYPE html>
<html lang="id">
  <head>
<script>
  window.SIAD_DATA = {
    namaDesa: "<%= locals.profil_desa ? locals.profil_desa.nama_kepenghuluan : 'Kepenghuluan Rokan Hilir' %>",
    namaKepalaDesa: "Inspektorat Kabupaten Rokan Hilir",
    alamat: "<%= locals.profil_desa ? locals.profil_desa.alamat : 'Jl. Brigjen Katamso, Bagansiapiapi' %>",
    deskripsiProfil: "Portal resmi Sistem Informasi Arsip Digital (SIAD) 2.0 untuk tata kelola 183 kepenghuluan di Kabupaten Rokan Hilir, Provinsi Riau."
  };
</script>
