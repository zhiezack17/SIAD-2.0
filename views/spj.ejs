                            <td style="padding: 10px; font-weight: 600; color: #475569;"><%= tgl %></td>
                            <td style="padding: 10px; font-weight: bold; color: #0f172a;">
                                <%= p.nama_kegiatan || 'Kegiatan #' + p.kegiatan_id %>
                                <% if (p.kegiatan_tahun) { %>
                                    <span style="font-size: 11px; color: #64748b; font-weight: normal;">(TA <%= p.kegiatan_tahun %>)</span>
                                <% } %>
                            </td>
                            <td style="padding: 10px; color: #334155;">
                                <div><%= p.uraian || '-' %></div>
                                <% if (p.nama_wp_rekanan) { %>
                                    <small style="color: #64748b; font-style: italic;">WP: <%= p.nama_wp_rekanan %></small>
                                <% } %>
                            </td>
                            <td style="padding: 10px;">
                                <% if (p.ntpn) { %>
                                    <div style="font-family: monospace; font-weight: bold; color: #166534; background: #dcfce7; padding: 2px 6px; border-radius: 4px; display: inline-block; font-size: 11px;">NTPN: <%= p.ntpn %></div>
                                <% } %>
                                <% if (p.kode_billing) { %>
                                    <div style="font-family: monospace; font-size: 11px; color: #475569; margin-top: 2px;">Bill: <%= p.kode_billing %></div>
                                <% } %>
                                <% if (!p.ntpn && !p.kode_billing) { %> - <% } %>
                            </td>
                            <td style="padding: 10px;">
                                <span style="background: <%= badgeBg %>; color: <%= badgeTxt %>; padding: 4px 8px; border-radius: 6px; font-weight: bold; font-size: 11px; display: inline-block;">
                                    <%= p.jenis_pajak %>
                                </span>
                            </td>
                            <td style="padding: 10px; text-align: right; font-weight: bold; color: #0f172a;">
                                Rp <%= Number(p.nominal || 0).toLocaleString('id-ID') %>
                            </td>
                            <td style="padding: 10px; text-align: center;">
                                <% if (p.file_url) { %>
                                    <a href="<%= p.file_url %>" target="_blank" style="background: #eef2ff; color: #4f46e5; padding: 4px 8px; border-radius: 4px; font-weight: bold; text-decoration: none; font-size: 11px; display: inline-block;">Lihat Drive</a>
                                <% } else { %>
                                    <span style="color: #94a3b8; font-size: 11px;">-</span>
                                <% } %>
                            </td>
                            <td style="padding: 10px; text-align: center;">
                                <form action="/spj/pajak/hapus" method="POST" onsubmit="return confirm('Hapus setoran pajak ini?')" style="margin:0;">
                                    <input type="hidden" name="id" value="<%= p.id %>">
                                    <input type="hidden" name="kegiatan_id" value="<%= p.kegiatan_id %>">
                                    <input type="hidden" name="redirect_to" value="rekap">
                                    <button type="submit" style="background: #fee2e2; color: #ef4444; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer; font-size: 11px; font-weight: bold;">Hapus</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                        <!-- BARIS TOTAL FOOTER -->
                        <tr style="background: #f8fafc; font-weight: bold; border-top: 2px solid #cbd5e1;">
                            <td colspan="6" style="padding: 14px 10px; text-align: right; color: #0f172a; font-size: 14px;">
                                TOTAL PENYETORAN PAJAK:
                            </td>
                            <td style="padding: 14px 10px; text-align: right; color: #15803d; font-size: 15px; font-weight: 800;">
                                Rp <%= Number(summary.totalSemua || 0).toLocaleString('id-ID') %>
                            </td>
                            <td colspan="2"></td>
                        </tr>
                    <% } else { %>
                        <tr>
                            <td colspan="9" style="padding: 40px; text-align: center; color: #94a3b8;">
                                <div style="font-size: 32px; margin-bottom: 10px;">🧾</div>
                                Belum ada data penyetoran pajak untuk filter yang dipilih. Silakan klik tombol <b>"+ Input Setoran Pajak"</b> di atas.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL INPUT SETORAN PAJAK CEPAT -->
<div id="modalSetorPajak" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); align-items: center; justify-content: center; z-index: 50;">
    <div style="background: white; padding: 25px; border-radius: 12px; width: 100%; max-width: 550px; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 2px solid #f1f5f9; padding-bottom: 10px;">
            <h3 style="margin:0; color: #0f172a;">Input Setoran Pajak (BPN / NTPN)</h3>
            <button onclick="document.getElementById('modalSetorPajak').style.display='none'" style="background:none; border:none; font-size:20px; cursor:pointer; color:#64748b;">&times;</button>
        </div>
        <form action="/spj/pajak/tambah" method="POST" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 12px;">
            <input type="hidden" name="redirect_to" value="rekap">
            
            <div>
                <label style="font-weight: bold; font-size: 13px; display: block; margin-bottom: 4px;">Kegiatan SPJ <span style="color:red;">*</span></label>
                <select name="kegiatan_id" required style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; background: white; font-size: 13px;">
