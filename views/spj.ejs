                        <th style="padding: 12px 10px; width: 100px;">Tgl Setor</th>
                        <th style="padding: 12px 10px;">Kegiatan SPJ</th>
                        <th style="padding: 12px 10px;">Uraian Belanja / Rekanan</th>
                        <th style="padding: 12px 10px;">NTPN / Kode Billing</th>
                        <th style="padding: 12px 10px; width: 110px;">Jenis Pajak</th>
                        <th style="padding: 12px 10px; text-align: right; width: 130px;">Nominal Setor</th>
                        <th style="padding: 12px 10px; text-align: center; width: 90px;">Bukti BPN</th>
                        <th style="padding: 12px 10px; text-align: center; width: 60px;">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof dataPajak !== 'undefined' && dataPajak && dataPajak.length > 0) { %>
