                            let badgeBg = '#e0f2fe'; let badgeTxt = '#0369a1';
                            const j = (p.jenis_pajak || '').toUpperCase();
                            if (j.includes('PPN')) { badgeBg = '#dbeafe'; badgeTxt = '#1e40af'; }
                            else if (j.includes('21')) { badgeBg = '#fef3c7'; badgeTxt = '#b45309'; }
                            else if (j.includes('22')) { badgeBg = '#f3e8ff'; badgeTxt = '#7e22ce'; }
                            else if (j.includes('23')) { badgeBg = '#ede9fe'; badgeTxt = '#6d28d9'; }
                            else if (j.includes('DAERAH')) { badgeBg = '#ccfbf1'; badgeTxt = '#0f766e'; }
