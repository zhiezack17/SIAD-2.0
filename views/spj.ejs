        <form id="formSPJ" action="/spj/tambah" method="POST" style="display:flex; flex-direction:column; gap:12px;">
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Nama Kegiatan <span style="color:red;">*</span></label>
                <input type="text" name="nama" placeholder="Cth: Pembangunan Semenisasi Jalan Lingkungan" required style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box;">
