                        <option value="PPh 21">PPh Pasal 21 (Upah/Honor)</option>
                        <option value="PPh 22">PPh Pasal 22 (Barang/Material)</option>
                        <option value="PPh 23">PPh Pasal 23 (Sewa/Jasa)</option>
