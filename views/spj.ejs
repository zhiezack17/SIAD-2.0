            <!-- BIDANG APBDES STANDAR SISKEUDES -->
            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Bidang Kegiatan (Standar Siskeudes / Permendagri 20/2018) <span style="color:red;">*</span></label>
                <select name="bidang" required style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box; background:white; font-size:12.5px; font-weight:600;">
                    <option value="Bidang 1: Penyelenggaraan Pemerintahan Desa">Bidang 1: Penyelenggaraan Pemerintahan Desa</option>
                    <option value="Bidang 2: Pelaksanaan Pembangunan Desa">Bidang 2: Pelaksanaan Pembangunan Desa</option>
                    <option value="Bidang 3: Pembinaan Kemasyarakatan Desa">Bidang 3: Pembinaan Kemasyarakatan Desa</option>
                    <option value="Bidang 4: Pemberdayaan Masyarakat Desa">Bidang 4: Pemberdayaan Masyarakat Desa</option>
                    <option value="Bidang 5: Penanggulangan Bencana, Keadaan Darurat dan Mendesak Desa">Bidang 5: Penanggulangan Bencana, Keadaan Darurat & Mendesak</option>
                </select>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
                <div>
                    <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Sumber Dana APBDes <span style="color:red;">*</span></label>
                    <select name="sumber_dana" required style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box; background:white; font-size:12.5px; font-weight:600;">
                        <option value="DDS (Dana Desa)">DDS (Dana Desa)</option>
                        <option value="ADD (Alokasi Dana Desa)">ADD (Alokasi Dana Desa)</option>
                        <option value="PBH (Bagi Hasil Pajak & Retribusi)">PBH (Bagi Hasil Pajak & Retribusi)</option>
                        <option value="PAD (Pendapatan Asli Desa)">PAD (Pendapatan Asli Desa)</option>
                        <option value="BKK (Bantuan Keuangan Khusus/Kab/Prov)">BKK (Bantuan Keuangan Khusus)</option>
                        <option value="DLL (Lain-lain Pendapatan Sah)">DLL (Lain-lain Pendapatan Sah)</option>
                    </select>
                </div>
                <div>
                    <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Kode Rekening Kegiatan</label>
                    <input type="text" name="kode_rekening" placeholder="Cth: 2.01.01" style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box; font-family:monospace;">
                </div>
            </div>

            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px;">
                <div>
                    <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Pagu Anggaran (Rp) <span style="color:red;">*</span></label>
                    <input type="number" name="pagu" placeholder="Cth: 75000000" required style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box;">
                </div>
                <div>
                    <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Realisasi Anggaran (Rp)</label>
                    <input type="number" name="realisasi_anggaran" placeholder="Cth: 75000000" style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box;">
                </div>
            </div>

            <div style="display:flex; gap:10px;">
                <div style="flex:1;">
                    <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Tahun Anggaran</label>
                    <input type="number" name="tahun" placeholder="Tahun" value="<%= new Date().getFullYear() %>" oninput="updateTahunNotice()" style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box;">
                    <div id="noticeTahunSPJ" style="margin-top: 5px; font-size: 11.5px; border-radius: 6px; padding: 6px 10px; display: none;"></div>
                </div>
                <div style="flex:1;">
                    <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Tahap / Semester</label>
                    <select name="tahap" style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box; background:white; font-weight:600;">
                        <option value="Tahap 1">Tahap 1</option>
                        <option value="Tahap 2">Tahap 2</option>
                        <option value="Semester 1">Semester 1</option>
                        <option value="Semester 2">Semester 2</option>
                    </select>
                </div>
            </div>

            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Lokasi Kegiatan</label>
                <input type="text" name="lokasi" placeholder="Cth: RT.02 / RW.01 Kepenghuluan" style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box;">
            </div>

            <div style="display:flex; gap:10px;">
                <div style="flex:1;">
                    <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Tgl Mulai</label>
                    <input type="date" name="tgl_mulai" style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box; background:white;">
                </div>
                <div style="flex:1;">
                    <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Tgl Selesai</label>
                    <input type="date" name="tgl_selesai" style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box; background:white;">
                </div>
            </div>

            <div id="statusContainerSPJ">
                <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Status Kegiatan</label>
                <select name="status" id="selectStatusSPJ" style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box; background:white;">
                    <option value="draft">Draft (Pelaksana)</option>
                    <option value="diajukan">Diajukan</option>
                    <option value="disetujui">Disetujui</option>
                    <option value="selesai">Selesai / Lunas</option>
                </select>
                <div id="noticeStatusSPJ" style="margin-top: 5px; font-size: 11px; color: #1e40af; background: #eff6ff; padding: 6px 10px; border-radius: 6px; border: 1px solid #bfdbfe; display: none;"></div>
            </div>

            <div>
                <label style="display:block; font-size:11px; font-weight:700; color:#475569; margin-bottom:3px;">Keterangan / Uraian</label>
                <textarea name="ket" rows="2" placeholder="Catatan kegiatan..." style="padding:9px 12px; border:1px solid #cbd5e1; border-radius:6px; width:100%; box-sizing:border-box; resize:vertical;"></textarea>
            </div>
            
            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:10px;">
                <button type="button" onclick="document.getElementById('modalSPJ').style.display='none'" style="padding:9px 18px; border:none; background:#e2e8f0; color:#475569; font-weight:700; border-radius:6px; cursor:pointer;">Batal</button>
                <button type="submit" style="padding:9px 20px; border:none; background:#1d4ed8; color:white; font-weight:700; border-radius:6px; cursor:pointer; box-shadow:0 2px 4px rgba(29,78,216,0.3);">Simpan</button>
            </div>
        </form>
    </div>
</div>

<script>
function handleJenisPajakChange() {
    const sel = document.getElementById('modalSetorJenisPajak');
    const lblNTPN = document.getElementById('labelNTPN');
    const inpNTPN = document.getElementById('inputNTPN');
    const lblBill = document.getElementById('labelBilling');
    const inpBill = document.getElementById('inputBilling');
    if (!sel || !lblNTPN) return;
    if (sel.value === 'Pajak Daerah') {
        lblNTPN.innerHTML = 'No. SSPD / Resi Bank Daerah <small style="color:#64748b; font-weight:normal;">(Opsional)</small>';
        inpNTPN.placeholder = 'Cth: No. SSPD Bank Riau Kepri';
        lblBill.innerHTML = 'Kode Setor Daerah <small style="color:#64748b; font-weight:normal;">(Opsional)</small>';
        inpBill.placeholder = 'Kode Bayar / Referensi';
    } else {
        lblNTPN.innerHTML = 'NTPN (Bukti Setor Kas Negara) <small style="color:#64748b; font-weight:normal;">(Opsional jika belum setor)</small>';
        inpNTPN.placeholder = '16 Digit NTPN';
        lblBill.innerHTML = 'Kode Billing DJP';
        inpBill.placeholder = '15 Digit Kode Billing';
    }
}

function bukaModalFilterRekap() {
    document.getElementById('modalFilterRekap').style.display = 'flex';
}

function bukaLembarRekap(e) {
    e.preventDefault();
    const thn = document.getElementById('rekapTahun').value;
    const thp = document.getElementById('rekapTahap').value;
    window.open('/spj/cetak-rekap?tahun=' + encodeURIComponent(thn) + '&tahap=' + encodeURIComponent(thp), '_blank');
    document.getElementById('modalFilterRekap').style.display = 'none';
}

function updateTahunNotice() {
    const thnInput = document.querySelector('#formSPJ [name="tahun"]');
    const noticeEl = document.getElementById('noticeTahunSPJ');
    const statusSel = document.getElementById('selectStatusSPJ');
    const noticeStatus = document.getElementById('noticeStatusSPJ');
    if (!thnInput || !noticeEl) return;
    const val = parseInt(thnInput.value, 10);
    
    if (val && val <= 2025) {
        noticeEl.style.display = 'block';
        noticeEl.style.background = '#f0fdf4';
        noticeEl.style.color = '#166534';
        noticeEl.style.border = '1px solid #86efac';
        noticeEl.innerHTML = '⚡ <b>Mode Arsip Historis (&le; 2025):</b> Otomatis langsung disahkan (Final) dari akun Bendahara tanpa perlu verifikasi 4 akun berjenjang.';
        if (statusSel) {
            statusSel.removeAttribute('disabled');
        }
        if (noticeStatus) noticeStatus.style.display = 'none';
    } else if (val && val >= 2026) {
        noticeEl.style.display = 'block';
        noticeEl.style.background = '#eff6ff';
        noticeEl.style.color = '#1e40af';
        noticeEl.style.border = '1px solid #bfdbfe';
        noticeEl.innerHTML = '🏛️ <b>Mode Berjalan (&ge; 2026):</b> Menggunakan alur verifikasi bertingkat 4 tahap (Kaur ➔ Bendahara ➔ Sekdes ➔ Penghulu).';
        if (statusSel) {
            statusSel.value = 'draft';
            statusSel.setAttribute('disabled', 'disabled');
        }
        if (noticeStatus) {
            noticeStatus.style.display = 'block';
            noticeStatus.innerHTML = '🔒 <b>Status Terkunci ke Draft:</b> Kegiatan TA 2026 ke atas wajib diajukan melalui alur verifikasi 4 tahap bertingkat.';
        }
    } else {
        noticeEl.style.display = 'none';
        if (statusSel) statusSel.removeAttribute('disabled');
        if (noticeStatus) noticeStatus.style.display = 'none';
    }
}

function bukaModalSPJ() {
    document.getElementById('modalTitleSPJ').textContent = 'Tambah Kegiatan SPJ';
    const form = document.getElementById('formSPJ');
    form.reset();
    form.action = '/spj/tambah';
    let idIn = document.getElementById('edit-spj-id');
    if(idIn) idIn.remove();
    document.getElementById('modalSPJ').style.display = 'flex';
    updateTahunNotice();
}

function bukaEditSPJJson(d) {
    if (!d) return;
    editSPJ(d.id, d.nama, d.tahun, d.pagu, d.lokasi, d.tgl_mulai, d.tgl_selesai, d.status, d.ket, d.tahap, d.bidang, d.kode_rekening, d.sumber_dana, d.realisasi_anggaran);
}

function editSPJ(id, nama, tahun, pagu, lokasi, tgl_mulai, tgl_selesai, status, ket, tahap, bidang, kodeRek, sumberDana, realisasiAnggaran) {
    document.getElementById('modalTitleSPJ').textContent = 'Edit Kegiatan SPJ';
    const form = document.getElementById('formSPJ');
    form.action = '/spj/edit';
    
    let idIn = document.getElementById('edit-spj-id');
    if(!idIn) { 
        idIn = document.createElement('input'); 
        idIn.type = 'hidden'; 
        idIn.name = 'id'; 
        idIn.id = 'edit-spj-id'; 
        form.appendChild(idIn); 
    }
    idIn.value = id;
    
    form.querySelector('[name="nama"]').value = nama;
    form.querySelector('[name="tahun"]').value = tahun;
    if(form.querySelector('[name="tahap"]')) form.querySelector('[name="tahap"]').value = tahap || 'Tahap 1';
    if(form.querySelector('[name="bidang"]')) form.querySelector('[name="bidang"]').value = bidang || 'Bidang 1: Penyelenggaraan Pemerintahan Desa';
    if(form.querySelector('[name="sumber_dana"]')) form.querySelector('[name="sumber_dana"]').value = sumberDana || 'DDS (Dana Desa)';
    if(form.querySelector('[name="kode_rekening"]')) form.querySelector('[name="kode_rekening"]').value = kodeRek || '';
    form.querySelector('[name="pagu"]').value = pagu;
    if(form.querySelector('[name="realisasi_anggaran"]')) form.querySelector('[name="realisasi_anggaran"]').value = realisasiAnggaran || pagu;
    form.querySelector('[name="lokasi"]').value = lokasi;
    form.querySelector('[name="tgl_mulai"]').value = tgl_mulai;
    form.querySelector('[name="tgl_selesai"]').value = tgl_selesai;
    
    const statusSel = document.getElementById('selectStatusSPJ');
    if (statusSel) {
        statusSel.value = status ? status.toLowerCase() : 'draft';
    }
    form.querySelector('[name="ket"]').value = ket;
    
    document.getElementById('modalSPJ').style.display = 'flex';
    updateTahunNotice();
}
</script>
<% } %>