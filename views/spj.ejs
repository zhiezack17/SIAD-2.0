                    </select>
                </div>
                <div>
                    <label style="font-weight: bold; font-size: 13px; display: block; margin-bottom: 4px;">Nominal Setor (Rp) <span style="color:red;">*</span></label>
                    <input type="number" name="nominal" required placeholder="Cth: 250000" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;">
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div>
                    <label style="font-weight: bold; font-size: 13px; display: block; margin-bottom: 4px;">NTPN (Bukti Setor Bank)</label>
                    <input type="text" name="ntpn" placeholder="16 Digit NTPN" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;">
                </div>
                <div>
                    <label style="font-weight: bold; font-size: 13px; display: block; margin-bottom: 4px;">Kode Billing DJP</label>
                    <input type="text" name="kode_billing" placeholder="15 Digit Kode Billing" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;">
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                <div>
                    <label style="font-weight: bold; font-size: 13px; display: block; margin-bottom: 4px;">Tanggal Penyetoran</label>
                    <input type="date" name="tanggal_setor" value="<%= new Date().toISOString().split('T')[0] %>" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;">
                </div>
                <div>
                    <label style="font-weight: bold; font-size: 13px; display: block; margin-bottom: 4px;">Nama Rekanan / WP</label>
                    <input type="text" name="nama_wp_rekanan" placeholder="Cth: UD. Bangun Jaya" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;">
                </div>
            </div>

            <div>
                <label style="font-weight: bold; font-size: 13px; display: block; margin-bottom: 4px;">Uraian Belanja</label>
                <input type="text" name="uraian" placeholder="Cth: Pemotongan Pajak Belanja Semen Pembangunan Semenisasi RT.02" style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;">
            </div>

            <div>
                <label style="font-weight: bold; font-size: 13px; display: block; margin-bottom: 4px;">Unggah Bukti Setor / BPN (PDF/Gambar)</label>
                <input type="file" name="file_bukti" style="width: 100%; padding: 8px 10px; border: 1px dashed #94a3b8; border-radius: 6px; background: #f8fafc; font-size: 13px;">
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px;">
                <button type="button" onclick="document.getElementById('modalSetorPajak').style.display='none'" style="padding: 9px 16px; border: none; background: #e2e8f0; color: #475569; border-radius: 6px; font-weight: bold; cursor: pointer;">Batal</button>
                <button type="submit" style="padding: 9px 18px; border: none; background: #1d4ed8; color: white; border-radius: 6px; font-weight: bold; cursor: pointer;">Simpan Setoran</button>
            </div>
        </form>
    </div>
</div>

<script>
// EXPORT DATA PAJAK KE EXCEL MENGGUNAKAN SHEETJS
function exportPajakToExcel() {
    const table = document.getElementById('tabelPajak');
    if (!table) return alert('Tabel data pajak tidak ditemukan!');

    const rows = [];
    const headers = ['No', 'Tanggal Setor', 'Kegiatan SPJ', 'Uraian Belanja', 'Nama Rekanan/WP', 'NTPN', 'Kode Billing', 'Jenis Pajak', 'Nominal Setor (Rp)'];
    rows.push(headers);

    const tbodyRows = table.querySelectorAll('tbody tr');
    let no = 1;
    tbodyRows.forEach(tr => {
        const cells = tr.querySelectorAll('td');
        if (cells.length >= 7 && !tr.innerText.includes('TOTAL PENYETORAN')) {
            const tgl = cells[1] ? cells[1].innerText.trim() : '';
            const keg = cells[2] ? cells[2].innerText.trim().replace(/\n/g, ' ') : '';
            const uraianEl = cells[3];
            const uraian = uraianEl ? (uraianEl.querySelector('div') ? uraianEl.querySelector('div').innerText.trim() : uraianEl.innerText.trim()) : '';
            const wp = uraianEl && uraianEl.querySelector('small') ? uraianEl.querySelector('small').innerText.replace('WP: ', '').trim() : '';
            
            const ntpnEl = cells[4];
            let ntpnVal = '';
            let billVal = '';
            if (ntpnEl) {
                const ntpnDiv = ntpnEl.querySelector('div:first-child');
                if (ntpnDiv && ntpnDiv.innerText.includes('NTPN:')) ntpnVal = ntpnDiv.innerText.replace('NTPN:', '').trim();
                const billDiv = ntpnEl.querySelector('div:nth-child(2)');
                if (billDiv && billDiv.innerText.includes('Bill:')) billVal = billDiv.innerText.replace('Bill:', '').trim();
            }

            const jenis = cells[5] ? cells[5].innerText.trim() : '';
            const nominalStr = cells[6] ? cells[6].innerText.replace(/[^0-9]/g, '') : '0';
            const nominal = Number(nominalStr) || 0;

            rows.push([no++, tgl, keg, uraian, wp, ntpnVal, billVal, jenis, nominal]);
        }
    });

    if (rows.length <= 1) {
        return alert('Tidak ada data setoran pajak untuk diekspor!');
    }

    const ws = XLSX.utils.aoa_to_sheet(rows);

    ws['!cols'] = [
        { wch: 6 },  // No
        { wch: 14 }, // Tgl Setor
        { wch: 35 }, // Kegiatan
        { wch: 40 }, // Uraian
        { wch: 25 }, // WP
        { wch: 20 }, // NTPN
        { wch: 18 }, // Billing
        { wch: 18 }, // Jenis
        { wch: 18 }  // Nominal
    ];

    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, 'Rekapitulasi Pajak');

    const tahun = '<%= filterTahun || "Semua_Tahun" %>';
    XLSX.writeFile(wb, `Rekapitulasi_Pajak_SIAD_${tahun}.xlsx`);
}
</script>

<% } else { %>
<!-- ========================================== -->
<!-- TAB KEGIATAN SPJ (DEFAULT LIST) -->
<!-- ========================================== -->
