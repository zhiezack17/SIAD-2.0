                    <label style="font-weight: bold; font-size: 13px; display: block; margin-bottom: 4px;">Jenis Pajak <span style="color:red;">*</span></label>
                    <select name="jenis_pajak" required style="width: 100%; padding: 8px 10px; border: 1px solid #cbd5e1; border-radius: 6px; background: white; font-size: 13px;">
