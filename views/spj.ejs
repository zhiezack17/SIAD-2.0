                    <th style="padding: 12px 10px;">Nama Kegiatan & Bidang APBDes</th>
                    <th style="padding: 12px 10px; width: 100px;">Sumber Dana</th>
                    <th style="padding: 12px 10px; width: 130px;">Pagu Anggaran</th>
                    <th style="padding: 12px 10px; width: 150px;">Realisasi (Rp & %)</th>
                    <th style="padding: 12px 10px; width: 110px;">Lokasi</th>
                    <th style="padding: 12px 10px; width: 125px;">Status Verifikasi</th>
                    <th style="padding: 12px 10px; width: 105px; text-align: center;">Notifikasi</th>
                    <th style="padding: 12px 10px; width: 160px; text-align: right;">Aksi</th>
