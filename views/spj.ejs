            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px;">
                <button type="button" onclick="document.getElementById('modalFilterRekap').style.display='none'" style="padding: 9px 16px; border: none; background: #e2e8f0; color: #475569; font-weight: bold; border-radius: 6px; cursor: pointer;">Batal</button>
                <button type="submit" style="padding: 9px 20px; border: none; background: #0f172a; color: white; font-weight: bold; border-radius: 6px; cursor: pointer; display: flex; align-items: center; gap: 6px;">
