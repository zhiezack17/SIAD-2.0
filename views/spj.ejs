                🖨️ Rekapitulasi Realisasi (Siskeudes)
            </button>
            <button type="button" onclick="toggleSidebar()" data-siad-tooltip="Sembunyikan / Tampilkan Menu Samping agar Ruang Tabel Lebih Luas" style="background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; padding: 10px 14px; border-radius: 6px; font-weight: bold; font-size: 13px; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 1px 2px rgba(0,0,0,0.05); transition: all 0.2s;">
                <i class="fa-solid fa-arrows-left-right-to-line"></i> <span id="labelModeLebar">Mode Layar Lebar</span>
            </button>
            <button id="btn-tambah-kegiatan" onclick="bukaModalSPJ()" data-siad-tooltip="Tambah kegiatan baru APBDes & pagu anggaran" style="background: #1d4ed8; color: white; padding: 10px 20px; border: none; border-radius: 6px; font-weight: bold; font-size: 13px; cursor: pointer; box-shadow: 0 2px 4px rgba(29,78,216,0.3);">
                + Tambah Kegiatan
            </button>
        </div>
    </div>
    
    <div style="overflow-x: auto;">
        <table id="tabel-spj-kegiatan" style="width: 100%; min-width: 1020px; border-collapse: collapse; margin-top: 10px; font-size: 13px;">
            <thead>
                <tr style="border-bottom: 2px solid #e2e8f0; color: #475569; text-align: left; background: #f8fafc;">
                    <th style="padding: 10px 8px; width: 35px; text-align: center;">No</th>
                    <th style="padding: 10px 12px; min-width: 270px; max-width: 360px;">Nama Kegiatan & Bidang APBDes</th>
                    <th style="padding: 10px 6px; width: 65px; text-align: center;">Sumber</th>
                    <th style="padding: 10px 8px; width: 110px;">Pagu Anggaran</th>
                    <th style="padding: 10px 8px; width: 120px;">Realisasi (Rp & %)</th>
                    <th style="padding: 10px 6px; width: 75px; text-align: center;">Lokasi</th>
                    <th style="padding: 10px 6px; width: 110px; text-align: center;">Status Verifikasi</th>
                    <th style="padding: 10px 6px; width: 85px; text-align: center;">Notifikasi</th>
                    <th style="padding: 10px 8px; width: 130px; text-align: right;">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (typeof data !== 'undefined' && data.length > 0) { %>
                    <% data.forEach((item, index) => { %>
                    <tr style="border-bottom: 1px solid #e2e8f0;">
                        <td style="padding: 12px 8px; text-align: center;"><%= index + 1 %></td>
                        <td style="padding: 10px 12px; min-width: 270px; max-width: 360px; line-height: 1.4;">
                            <div style="font-weight: bold; color: #0f172a; font-size: 13.5px;"><%= item.nama_kegiatan %></div>
                            <div style="margin-top: 4px; display: flex; flex-wrap: wrap; gap: 5px; align-items: center;">
                                <span style="background: #e0f2fe; color: #0369a1; padding: 2px 7px; border-radius: 4px; font-weight: 700; font-size: 11px;">
                                    TA <%= item.tahun %> • <%= item.tahap || 'Tahap 1' %>
                                </span>
                                <span style="background: #f1f5f9; color: #334155; padding: 2px 7px; border-radius: 4px; font-weight: 600; font-size: 11px; border: 1px solid #e2e8f0;">
                                    🏷️ <%= item.bidang || 'Bidang 1: Penyelenggaraan Pemerintahan Desa' %>
                                </span>
                                <% if (item.kode_rekening) { %>
                                    <span style="background: #fef3c7; color: #92400e; padding: 2px 6px; border-radius: 4px; font-family: monospace; font-size: 10.5px; font-weight: bold;">
                                        Rek: <%= item.kode_rekening %>
                                    </span>
                                <% } %>
                            </div>
                        </td>
                        <td style="padding: 12px 10px; vertical-align: middle;">
                            <% 
                                const sDana = item.sumber_dana || 'DDS (Dana Desa)';
                                let sDanaCode = 'DDS';
                                if (sDana.includes('ADD')) sDanaCode = 'ADD';
                                else if (sDana.includes('PBH')) sDanaCode = 'PBH';
                                else if (sDana.includes('PAD')) sDanaCode = 'PAD';
                                else if (sDana.includes('BKK')) sDanaCode = 'BKK';
                                else if (sDana.includes('DLL')) sDanaCode = 'DLL';
                            %>
                            <span style="background: #eef2ff; color: #3730a3; padding: 3px 8px; border-radius: 6px; font-weight: 700; font-size: 11px; border: 1px solid #c7d2fe; display: inline-block;">
                                <%= sDanaCode %>
                            </span>
                        </td>
                        <td style="padding: 12px 10px; font-weight: bold; color: #1e293b; vertical-align: middle;">Rp <%= Number(item.pagu_anggaran).toLocaleString('id-ID') %></td>
                        <td style="padding: 12px 10px; vertical-align: middle;">
                            <%
                                const pVal = Number(item.pagu_anggaran) || 0;
                                const rVal = (item.realisasi_anggaran !== null && typeof item.realisasi_anggaran !== 'undefined') ? Number(item.realisasi_anggaran) : (item.status === 'SELESAI' || (item.tahap_verifikasi === 'SELESAI_FINAL') ? pVal : 0);
                                const pctVal = pVal > 0 ? Math.min(100, Math.round((rVal / pVal) * 100)) : 0;
                                let barCol = '#10b981';
                                if (pctVal < 50) barCol = '#f59e0b';
                                if (pctVal === 0) barCol = '#94a3b8';
                            %>
                            <div style="font-weight: 800; color: #0f172a; font-size: 12.5px;">Rp <%= rVal.toLocaleString('id-ID') %></div>
                            <div style="display: flex; align-items: center; gap: 6px; margin-top: 3px;">
                                <div style="flex: 1; height: 5px; background: #e2e8f0; border-radius: 4px; overflow: hidden;">
                                    <div style="width: <%= pctVal %>%; height: 100%; background: <%= barCol %>; border-radius: 4px;"></div>
                                </div>
                                <span style="font-size: 10.5px; font-weight: 700; color: #475569;"><%= pctVal %>%</span>
                            </div>
                        </td>
                        <td style="padding: 10px 6px; text-align: center; color: #475569; font-size: 12px;"><%= item.lokasi || '-' %></td>
                        <td style="padding: 10px 6px; text-align: center;">
                            <% 
                                const isHistorisItem = Number(item.tahun) <= 2025;
                                const tahapVerif = item.tahap_verifikasi || 'DRAFT'; 
                                let bg = '#fef08a'; let txt = '#854d0e'; let lbl = 'Draft (Kaur)';
                                if (isHistorisItem) {
                                    if (tahapVerif === 'SELESAI_FINAL') {
                                        bg = '#dcfce7'; txt = '#15803d'; lbl = '🗄️ Arsip Sah (Direct)';
                                    } else {
                                        bg = '#fef3c7'; txt = '#b45309'; lbl = '🗄️ Arsip (Menunggu Sahkan)';
                                    }
                                } else {
                                    if (tahapVerif === 'VERIFIKASI_BENDAHARA') { bg = '#fef3c7'; txt = '#b45309'; lbl = 'Menunggu Bendahara'; }
                                    else if (tahapVerif === 'VERIFIKASI_SEKDES') { bg = '#e0e7ff'; txt = '#3730a3'; lbl = 'Menunggu Sekdes'; }
                                    else if (tahapVerif === 'VERIFIKASI_PENGHULU') { bg = '#dbeafe'; txt = '#1d4ed8'; lbl = 'Menunggu Penghulu'; }
                                    else if (tahapVerif === 'SELESAI_FINAL') { bg = '#dcfce7'; txt = '#15803d'; lbl = 'Disahkan (Sah)'; }
                                    else if (tahapVerif === 'PERLU_REVISI') { bg = '#fee2e2'; txt = '#b91c1c'; lbl = 'Perlu Revisi'; }
                                }
                            %>
                            <span style="background:<%= bg %>; color:<%= txt %>; padding:4px 9px; border-radius:12px; font-size:11.5px; font-weight:bold; display:inline-block;"><%= lbl %></span>
                        </td>
                        
                        <!-- TOMBOL CEPAT NOTIFIKASI WHATSAPP BERJENJANG / ARSIP -->
                        <td style="padding: 10px 6px; text-align: center;">
                            <% 
                                const paguFmt = 'Rp ' + Number(item.pagu_anggaran).toLocaleString('id-ID');
                                let waMsg = '';
                                let waBtnLabel = '📲 WA Sekdes';
                                let waBgColor = '#25D366';

                                if (isHistorisItem) {
                                    waMsg = `Pemberitahuan Arsip: Berkas SPJ Kegiatan *${item.nama_kegiatan}* (TA ${item.tahun}) sebesar *${paguFmt}* telah tersimpan & diarsipkan di aplikasi SIAD 2.0. Status: Sah & Disahkan Langsung tanpa kendala berjenjang.`;
                                    waBtnLabel = '📲 Info Arsip';
                                    waBgColor = '#059669';
                                } else if (tahapVerif === 'DRAFT' || !tahapVerif) {
                                    waMsg = `Halo Bapak/Ibu Sekdes, mohon izin menyampaikan bahwa berkas SPJ Kegiatan *${item.nama_kegiatan}* (TA ${item.tahun}, ${item.tahap || 'Tahap 1'}) dengan anggaran *${paguFmt}* telah selesai diinput di aplikasi SIAD 2.0 dan menunggu verifikasi Bapak/Ibu Sekdes. Terima kasih 🙏`;
                                    waBtnLabel = '📲 WA Sekdes';
                                    waBgColor = '#25D366';
                                } else if (tahapVerif === 'VERIFIKASI_BENDAHARA') {
                                    waMsg = `Halo Bendahara, berkas SPJ Kegiatan *${item.nama_kegiatan}* (TA ${item.tahun}, ${item.tahap || 'Tahap 1'}) sebesar *${paguFmt}* telah diajukan dan menunggu verifikasi kelengkapan keuangan & penyetoran pajak di aplikasi SIAD 2.0. Terima kasih 🙏`;
                                    waBtnLabel = '📲 WA Bendahara';
                                    waBgColor = '#16a34a';
                                } else if (tahapVerif === 'VERIFIKASI_SEKDES') {
                                    waMsg = `Halo Bapak/Ibu Sekdes, berkas SPJ Kegiatan *${item.nama_kegiatan}* (TA ${item.tahun}) telah diverifikasi Bendahara dan sekarang siap untuk diverifikasi administratif oleh Bapak/Ibu Sekdes di SIAD 2.0. Terima kasih 🙏`;
                                    waBtnLabel = '📲 WA Sekdes';
                                    waBgColor = '#25D366';
                                } else if (tahapVerif === 'VERIFIKASI_PENGHULU') {
                                    waMsg = `Yth. Bapak Penghulu, berkas SPJ Kegiatan *${item.nama_kegiatan}* (TA ${item.tahun}, ${item.tahap || 'Tahap 1'}) sebesar *${paguFmt}* telah lengkap diverifikasi oleh Sekdes dan Bendahara. Mohon kesediaan Bapak Penghulu untuk memberikan persetujuan / pengesahan akhir di aplikasi SIAD 2.0. Terima kasih 🙏`;
                                    waBtnLabel = '📲 WA Penghulu';
                                    waBgColor = '#047857';
                                } else if (tahapVerif === 'PERLU_REVISI') {
                                    const catRevisi = item.catatan_revisi || 'Mohon cek kelengkapan bukti dan nota';
                                    waMsg = `Pemberitahuan Revisi SPJ: Berkas SPJ Kegiatan *${item.nama_kegiatan}* (TA ${item.tahun}) memerlukan perbaikan. Catatan revisi: "${catRevisi}". Mohon segera diperbaiki melalui aplikasi SIAD 2.0. Terima kasih 🙏`;
                                    waBtnLabel = '📲 WA Revisi';
                                    waBgColor = '#dc2626';
                                } else if (tahapVerif === 'SELESAI_FINAL') {
                                    waMsg = `Pemberitahuan Resmi: SPJ Kegiatan *${item.nama_kegiatan}* (TA ${item.tahun}, ${item.tahap || 'Tahap 1'}) sebesar *${paguFmt}* telah SAH & SELESAI disahkan oleh Penghulu di aplikasi SIAD 2.0. Lembar pengesahan ber-barcode resmi dapat diunduh di sistem. Terima kasih.`;
                                    waBtnLabel = '📲 Bagikan WA';
                                    waBgColor = '#059669';
                                }
                            %>
                            <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(waMsg) %>" target="_blank" title="Kirim Notifikasi Cepat ke WhatsApp" style="text-decoration:none; background:<%= waBgColor %>; color:white; padding:5px 9px; border-radius:6px; font-size:11px; font-weight:bold; display:inline-flex; align-items:center; gap:3px; box-shadow: 0 1px 2px rgba(0,0,0,0.1);">
                                <%= waBtnLabel %>
                            </a>
                        </td>

                        <td style="padding: 10px 8px; text-align: right;">
                            <div style="display: flex; gap: 3px; justify-content: flex-end; align-items: center;">
