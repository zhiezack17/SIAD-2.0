<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <!-- Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            background: #e2e8f0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        /* Top Action Bar (hidden on print) */
        .action-bar {
            width: 100%;
            max-width: 650px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.7rem 1.4rem;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s ease;
            border: none;
        }

        .btn-print {
            background: #059669;
            color: #fff;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);
        }

        .btn-print:hover {
            background: #047857;
            transform: translateY(-2px);
        }

        .btn-back {
            background: #ffffff;
            color: #334155;
            border: 1px solid #cbd5e1;
        }

        .btn-back:hover {
            background: #f8fafc;
        }

        /* The Printable Acrylic Sheet (A4 Proportion) */
        .acrylic-sheet {
            width: 100%;
            max-width: 650px;
            background: #ffffff;
            border-radius: 28px;
            padding: 3rem 2.5rem;
            box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.18);
            border: 2px solid #e2e8f0;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        /* Decorative border gradient */
        .acrylic-sheet::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 10px;
            background: linear-gradient(90deg, #059669, #10b981, #3b82f6);
        }

        .logo-box {
            width: 80px;
            height: 80px;
            margin: 0 auto 1.25rem;
            object-fit: contain;
        }

        .kop-pemerintah h3 {
            font-size: 0.95rem;
            font-weight: 800;
            color: #475569;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .kop-pemerintah h2 {
            font-size: 1.35rem;
            font-weight: 900;
            color: #0f172a;
            margin: 0.25rem 0;
            letter-spacing: -0.3px;
        }

        .kop-pemerintah p {
            font-size: 0.9rem;
            color: #64748b;
            font-weight: 600;
        }

        .divider {
            width: 100%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #cbd5e1, transparent);
            margin: 1.75rem 0;
        }

        .qr-hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: #ecfdf5;
            border: 1.5px solid #a7f3d0;
            color: #065f46;
            padding: 0.45rem 1.25rem;
            border-radius: 999px;
            font-size: 0.88rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 1.25rem;
        }

        .qr-card-frame {
            display: inline-block;
            background: #ffffff;
            border: 3px solid #0f172a;
            border-radius: 24px;
            padding: 1rem;
            box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.15);
            margin-bottom: 1.5rem;
        }

        .qr-card-frame img {
            width: 250px;
            height: 250px;
            display: block;
            border-radius: 12px;
        }

        .scan-instructions h4 {
            font-size: 1.2rem;
            font-weight: 800;
            color: #0f172a;
            margin-bottom: 0.5rem;
        }

        .steps-list {
            display: flex;
            justify-content: center;
            gap: 1.5rem;
            margin-top: 1rem;
            text-align: left;
        }

        .step-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.84rem;
            font-weight: 600;
            color: #334155;
        }

        .step-num {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: #059669;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: 800;
            flex-shrink: 0;
        }

        .target-url-box {
            margin-top: 1.75rem;
            padding: 0.6rem 1rem;
            background: #f8fafc;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            font-size: 0.78rem;
            color: #64748b;
            font-family: monospace;
            word-break: break-all;
        }

        /* Print Media Styles */
        @media print {
            body {
                background: #ffffff;
                padding: 0;
            }
            .action-bar {
                display: none !important;
            }
            .acrylic-sheet {
                box-shadow: none;
                border: 1px solid #cbd5e1;
                max-width: 100%;
                margin: 0;
                padding: 2.5cm 2cm;
            }
        }
    </style>
</head>
<body>
    <!-- Top Action Toolbar -->
    <div class="action-bar">
        <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
            <a href="/portal" class="btn-action btn-back">
                <i class="fa-solid fa-arrow-left"></i>
                <span>Kembali ke Portal</span>
            </a>
            <% if (typeof kepList !== 'undefined' && kepList.length > 0) { %>
            <form method="GET" action="/resepsionis/standing-qr" style="display:flex; align-items:center; gap:6px;">
                <label style="font-size:0.82rem; font-weight:700; color:#334155; white-space:nowrap;">Pilih Desa:</label>
                <select name="desa" onchange="this.form.submit()" style="padding:0.6rem 0.9rem; border-radius:10px; border:1px solid #cbd5e1; font-size:0.85rem; font-weight:700; background:#fff; color:#0f172a; cursor:pointer; max-width:280px; text-overflow:ellipsis;">
                    <% kepList.forEach(k => { %>
                        <option value="<%= k.id %>" <%= String(k.id) === String(kepInfo.id) ? 'selected' : '' %>>
                            <%= k.nama %> (Kec. <%= k.kecamatan %>)
                        </option>
                    <% }) %>
                </select>
            </form>
            <% } %>
        </div>

        <button onclick="window.print()" class="btn-action btn-print">
            <i class="fa-solid fa-print"></i>
            <span>Cetak Lembar Standing</span>
        </button>
    </div>

    <!-- Acrylic Sheet -->
    <div class="acrylic-sheet">
        <img src="/img/logo.png" alt="Logo Pemkab Rokan Hilir" class="logo-box" onerror="this.src='https://upload.wikimedia.org/wikipedia/commons/thumb/c/ca/Lambang_Kabupaten_Rokan_Hilir.png/240px-Lambang_Kabupaten_Rokan_Hilir.png'">
        
        <div class="kop-pemerintah">
            <h3>Pemerintah Kabupaten Rokan Hilir</h3>
            <h2>KEPENGHULUAN <%= kepInfo.nama.toUpperCase() %></h2>
            <p>Kecamatan <%= kepInfo.kecamatan %> - Provinsi Riau</p>
        </div>

        <div class="divider"></div>

        <div class="qr-hero-badge">
            <i class="fa-solid fa-qrcode"></i>
            <span>Buku Tamu Digital Resmi</span>
        </div>

        <!-- The Big Scannable QR -->
        <div class="qr-card-frame">
            <img src="<%= qrDataUrl %>" alt="QR Code Buku Tamu Kepenghuluan <%= kepInfo.nama %>">
        </div>

        <div class="scan-instructions">
            <h4>Selamat Datang di Kantor Kepenghuluan</h4>
            <p style="font-size:0.9rem; color:#64748b; max-width:440px; margin:0 auto;">
                Silakan scan QR Code di atas menggunakan kamera smartphone Anda untuk mengisi daftar kunjungan digital.
            </p>

            <div class="steps-list">
                <div class="step-item">
                    <div class="step-num">1</div>
                    <span>Buka Kamera HP</span>
                </div>
                <div class="step-item">
                    <div class="step-num">2</div>
                    <span>Arahkan ke QR</span>
                </div>
                <div class="step-item">
                    <div class="step-num">3</div>
                    <span>Isi Form Online</span>
                </div>
            </div>
        </div>

        <div class="target-url-box">
            Akses Langsung: <%= targetUrl %>
        </div>
    </div>
</body>
</html>
